# Runtime default. Compose sets the mounted path explicitly for each image;
# standalone mode uses /app/feedback/learning_feedback.jsonl.
JIN_FEEDBACK_PATH=/app/training/feedback/learning_feedback.jsonl
JIN_FEEDBACK_TOKEN=
JIN_FEEDBACK_RETRAIN_ON_WRITE=0
# Deprecated compatibility alias. Human users now authenticate with accounts.
JIN_STUDIO_TOKEN=
# Optional token reserved for machine-to-machine Studio API calls.
JIN_STUDIO_SERVICE_TOKEN=
# Optional dedicated MCP token. Empty means: reuse the Studio service token.
JIN_STUDIO_MCP_TOKEN=
# File-backed token is generated automatically by Compose when env tokens are empty.
JIN_STUDIO_SERVICE_TOKEN_FILE=/app/data/studio/service-token
# Keep 0 unless remote MCP calls are made by an authenticated human-review system.
JIN_STUDIO_MCP_ALLOW_VALIDATION=0
JIN_STUDIO_MCP_ALLOWED_HOSTS=mcp,mcp:*,localhost,localhost:*,127.0.0.1,127.0.0.1:*
JIN_STUDIO_MCP_ALLOWED_ORIGINS=
# Use 0.0.0.0 only behind a firewall/VPN or an HTTPS reverse proxy.
JIN_WEB_BIND=127.0.0.1
JIN_WEB_PORT=8080
JIN_STUDIO_PASSWORD_MIN_LENGTH=8
JIN_STUDIO_SESSION_HOURS=12
# auto enables Secure cookies when X-Forwarded-Proto is https.
JIN_STUDIO_COOKIE_SECURE=auto
JIN_STUDIO_DIR=/app/data/studio
JIN_STUDIO_SHARED_STORAGE=1
JIN_STUDIO_MIN_TRAINING_DOCUMENTS=20
JIN_STUDIO_TRAINING_POLL_SECONDS=10
JIN_STUDIO_TRAINING_HEARTBEAT_SECONDS=10
JIN_STUDIO_TRAINING_STALE_SECONDS=900
JIN_STUDIO_TRAINING_STEP_TIMEOUT_SECONDS=86400
JIN_TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
JIN_LEARNING_MODEL_DIR=/app/data/learning
JIN_CORPUS_ROUTER_MODEL=/app/data/learning/corpus_text_router.joblib
JIN_PDF_ROUTER_MODEL=/app/data/learning/jin-pdf-fusion-router-v3-cpu.joblib
JIN_FIELD_ROUTER_MODEL=/app/data/learning/jin-field-weak-router-v2-cpu.joblib
JIN_FIELD_ROUTER_THRESHOLD=0.80
JIN_OCR_LANGS=fra+eng+deu
JIN_ROLE_OVERRIDE_THRESHOLD=0.93
JIN_COMPONENT_FILL_THRESHOLD=0.88
JIN_ALLOW_ROLE_OVERRIDE=1
JIN_FILL_MISSING_COMPONENTS=1
