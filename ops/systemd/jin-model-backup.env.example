# Directory on the VM used only as a staging area before Azure upload.
JIN_BACKUP_ROOT=./backups

# Private Azure Blob container. Do not place an account key here: the VM uses
# its managed identity and must have the Storage Blob Data Contributor role.
JIN_BACKUP_AZURE_ACCOUNT=replace-me
JIN_BACKUP_AZURE_CONTAINER=jin-model-backups
JIN_BACKUP_AZURE_PREFIX=production
JIN_BACKUP_AZURE_LOGIN_IDENTITY=1

# Optional when python3 is not the desired host interpreter.
PYTHON_BIN=python3
