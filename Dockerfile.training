FROM python:3.12-slim

ARG JIN_BUILD_HTTP_PROXY
ARG JIN_BUILD_HTTPS_PROXY
ARG JIN_BUILD_NO_PROXY
ARG JIN_TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu

RUN export HTTP_PROXY="$JIN_BUILD_HTTP_PROXY" HTTPS_PROXY="$JIN_BUILD_HTTPS_PROXY" NO_PROXY="$JIN_BUILD_NO_PROXY" \
    http_proxy="$JIN_BUILD_HTTP_PROXY" https_proxy="$JIN_BUILD_HTTPS_PROXY" no_proxy="$JIN_BUILD_NO_PROXY" \
    && apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr \
    tesseract-ocr-eng \
    tesseract-ocr-fra \
    tesseract-ocr-deu \
    poppler-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY runtime-requirements.txt /tmp/jin-runtime-requirements.txt
COPY requirements-vision.txt /tmp/jin-vision-requirements.txt
RUN export HTTP_PROXY="$JIN_BUILD_HTTP_PROXY" HTTPS_PROXY="$JIN_BUILD_HTTPS_PROXY" NO_PROXY="$JIN_BUILD_NO_PROXY" \
    http_proxy="$JIN_BUILD_HTTP_PROXY" https_proxy="$JIN_BUILD_HTTPS_PROXY" no_proxy="$JIN_BUILD_NO_PROXY" \
    && pip install --no-cache-dir "torch>=2.4,<3" --index-url "$JIN_TORCH_INDEX_URL" \
    && pip install --no-cache-dir \
    -r /tmp/jin-runtime-requirements.txt \
    -r /tmp/jin-vision-requirements.txt

COPY jin_runtime/ /app/jin_runtime/
COPY training/vision/ /app/training/vision/

ENV JIN_STUDIO_DIR=/app/data/studio \
    HF_HOME=/app/data/huggingface \
    TOKENIZERS_PARALLELISM=false

CMD ["python", "-m", "jin_runtime.studio_training_worker"]
